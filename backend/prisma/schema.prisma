generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?
  phone        String?
  passwordHash String
  role         Role     @default(RESIDENT)
  flatId       String?
  createdAt    DateTime @default(now())
  flat         Flat?    @relation(fields: [flatId], references: [id])
}

model Flat {
  id                    String              @id @default(cuid())
  flatNumber            String              @unique
  ownerName             String
  phone                 String?
  email                 String?
  monthlyRate           Float
  status                FlatStatus          @default(ACTIVE)
  createdAt             DateTime            @default(now())
  maintenanceStartMonth String?
  isCollector           Boolean             @default(false)
  areaSqFt              Float?
  complaints            Complaint[]
  contributedExpenses   Expense[]
  bills                 MaintenanceBill[]
  memberLedgerEntries   MemberLedgerEntry[]
  payments              Payment[]
  projectPayments       ProjectPayment[]
  projectShares         ProjectShare[]
  users                 User[]
}

model MaintenanceBill {
  id        String     @id @default(cuid())
  flatId    String
  month     String
  amount    Float
  dueDate   DateTime
  status    BillStatus @default(UNPAID)
  note      String?
  createdAt DateTime   @default(now())
  flat      Flat       @relation(fields: [flatId], references: [id])
  payments  Payment[]

  @@unique([flatId, month])
}

model Payment {
  id             String           @id @default(cuid())
  flatId         String
  billId         String?
  amount         Float
  date           DateTime
  mode           PaymentMode      @default(CASH)
  receiptNo      String           @unique
  note           String?
  createdAt      DateTime         @default(now())
  groupReceiptNo String?
  bill           MaintenanceBill? @relation(fields: [billId], references: [id])
  flat           Flat             @relation(fields: [flatId], references: [id])
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  amount       Float
  date         DateTime
  description  String
  billUpload   String?
  createdAt    DateTime        @default(now())
  paidByFlatId String?
  paidByFlat   Flat?           @relation(fields: [paidByFlatId], references: [id])
}

model Staff {
  id             String          @id @default(cuid())
  name           String
  role           String
  salary         Float
  joiningDate    DateTime
  status         String          @default("ACTIVE")
  salaryPayments SalaryPayment[]
}

model SalaryPayment {
  id       String       @id @default(cuid())
  staffId  String
  month    String
  amount   Float
  datePaid DateTime?
  status   SalaryStatus @default(PENDING)
  staff    Staff        @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
}

model CashTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  type        CashType
  amount      Float
  balance     Float
  description String
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())
}

model BankTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  type        BankType
  amount      Float
  balance     Float
  description String
  createdAt   DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  postedBy  String
  createdAt DateTime @default(now())
}

model Complaint {
  id          String            @id @default(cuid())
  flatId      String
  category    ComplaintCategory
  description String
  status      ComplaintStatus   @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  flat        Flat              @relation(fields: [flatId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model MemberLedgerEntry {
  id          String   @id @default(cuid())
  flatId      String
  date        DateTime
  type        String
  amount      Float
  description String
  expenseId   String?
  createdAt   DateTime @default(now())
  flat        Flat     @relation(fields: [flatId], references: [id])
}

model SpecialProject {
  id           String           @id @default(cuid())
  title        String
  description  String?
  targetAmount Float
  status       ProjectStatus    @default(COLLECTING)
  createdAt    DateTime         @default(now())
  closedAt     DateTime?
  closingNote  String?
  expenses     ProjectExpense[]
  payments     ProjectPayment[]
  shares       ProjectShare[]
}

model ProjectShare {
  id        String         @id @default(cuid())
  projectId String
  flatId    String
  areaSqFt  Float
  dueAmount Float
  flat      Flat           @relation(fields: [flatId], references: [id])
  project   SpecialProject @relation(fields: [projectId], references: [id])

  @@unique([projectId, flatId])
}

model ProjectPayment {
  id        String         @id @default(cuid())
  projectId String
  flatId    String
  amount    Float
  date      DateTime
  mode      PaymentMode    @default(CASH)
  note      String?
  receiptNo String?        @unique
  createdAt DateTime       @default(now())
  flat      Flat           @relation(fields: [flatId], references: [id])
  project   SpecialProject @relation(fields: [projectId], references: [id])
}

model ProjectExpense {
  id          String         @id @default(cuid())
  projectId   String
  amount      Float
  date        DateTime
  description String
  billUpload  String?
  createdAt   DateTime       @default(now())
  project     SpecialProject @relation(fields: [projectId], references: [id])
}

enum Role {
  ADMIN
  RESIDENT
}

enum BillStatus {
  PAID
  PARTIAL
  UNPAID
  WAIVED
}

enum PaymentMode {
  CASH
  UPI
  BANK
  ADJUSTMENT
}

enum SalaryStatus {
  PAID
  PENDING
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICITY
  LIFT
  CLEANING
  SECURITY
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  CLEANER_SALARY
  SECURITY_SALARY
  REPAIRS
  LIFT_MAINTENANCE
  GARDENING
  MISCELLANEOUS
}

enum CashType {
  IN
  OUT
}

enum BankType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum FlatStatus {
  ACTIVE
  VACANT
}

enum ProjectStatus {
  COLLECTING
  IN_PROGRESS
  COMPLETED
  CLOSED
}
