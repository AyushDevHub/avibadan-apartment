generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESIDENT
}

enum BillStatus {
  PAID
  PARTIAL
  UNPAID
  WAIVED
}

enum PaymentMode {
  CASH
  UPI
  BANK
  ADJUSTMENT
}

enum SalaryStatus {
  PAID
  PENDING
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplaintCategory {
  PLUMBING
  ELECTRICITY
  LIFT
  CLEANING
  SECURITY
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  WATER
  CLEANER_SALARY
  SECURITY_SALARY
  REPAIRS
  LIFT_MAINTENANCE
  GARDENING
  MISCELLANEOUS
}

enum CashType {
  IN
  OUT
}

enum BankType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
}

enum FlatStatus {
  ACTIVE
  VACANT
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String?
  phone        String?
  passwordHash String
  role         Role     @default(RESIDENT)
  flatId       String?
  flat         Flat?    @relation(fields: [flatId], references: [id])
  createdAt    DateTime @default(now())
}

model Flat {
  id                    String            @id @default(cuid())
  flatNumber            String            @unique
  ownerName             String
  phone                 String?
  email                 String?
  monthlyRate           Float
  areaSqFt              Float?
  maintenanceStartMonth String?
  status                FlatStatus        @default(ACTIVE)
  createdAt             DateTime          @default(now())
  users                 User[]
  bills                 MaintenanceBill[]
  payments              Payment[]
  complaints            Complaint[]
  contributedExpenses   Expense[]
  isCollector           Boolean              @default(false)
  memberLedgerEntries   MemberLedgerEntry[]
  projectShares         ProjectShare[]
  projectPayments       ProjectPayment[]
}

model MaintenanceBill {
  id        String     @id @default(cuid())
  flatId    String
  flat      Flat       @relation(fields: [flatId], references: [id])
  month     String
  amount    Float
  dueDate   DateTime
  status    BillStatus @default(UNPAID)
  note      String?
  createdAt DateTime   @default(now())
  payments  Payment[]

  @@unique([flatId, month])
}

model Payment {
  id             String           @id @default(cuid())
  flatId         String
  flat           Flat             @relation(fields: [flatId], references: [id])
  billId         String?
  bill           MaintenanceBill? @relation(fields: [billId], references: [id])
  amount         Float
  date           DateTime
  mode           PaymentMode      @default(CASH)
  receiptNo      String           @unique
  groupReceiptNo String?
  note           String?
  createdAt      DateTime         @default(now())
}

model Expense {
  id           String          @id @default(cuid())
  category     ExpenseCategory
  amount       Float
  date         DateTime
  description  String
  billUpload   String?
  paidByFlatId String?
  paidByFlat   Flat?           @relation(fields: [paidByFlatId], references: [id])
  createdAt    DateTime        @default(now())
}

model Staff {
  id             String          @id @default(cuid())
  name           String
  role           String
  salary         Float
  joiningDate    DateTime
  status         String          @default("ACTIVE")
  salaryPayments SalaryPayment[]
}

model SalaryPayment {
  id       String       @id @default(cuid())
  staffId  String
  staff    Staff        @relation(fields: [staffId], references: [id])
  month    String
  amount   Float
  datePaid DateTime?
  status   SalaryStatus @default(PENDING)

  @@unique([staffId, month])
}

model CashTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  type        CashType
  amount      Float
  balance     Float
  description String
  refType     String?
  refId       String?
  createdAt   DateTime @default(now())
}

model BankTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  type        BankType
  amount      Float
  balance     Float
  description String
  createdAt   DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  postedBy  String
  createdAt DateTime @default(now())
}

model Complaint {
  id          String            @id @default(cuid())
  flatId      String
  flat        Flat              @relation(fields: [flatId], references: [id])
  category    ComplaintCategory
  description String
  status      ComplaintStatus   @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model MemberLedgerEntry {
  id          String   @id @default(cuid())
  flatId      String
  flat        Flat     @relation(fields: [flatId], references: [id])
  date        DateTime
  type        String
  amount      Float
  description String
  expenseId   String?
  createdAt   DateTime @default(now())
}

enum ProjectStatus {
  COLLECTING   // gathering funds from residents, not yet spending
  IN_PROGRESS  // work started, expenses being logged
  COMPLETED    // work finished, leftover budget still sitting in project
  CLOSED       // leftover budget swept into main cashbook, project archived
}

// A big one-off project (repainting, waterproofing, lift overhaul, etc.)
// funded by a special one-time collection, split per flat by area (sq.ft),
// kept on its own balance sheet separate from the regular maintenance
// cashbook until it's finished and any leftover is handed back to the pot.
model SpecialProject {
  id            String          @id @default(cuid())
  title         String
  description   String?
  targetAmount  Float
  status        ProjectStatus   @default(COLLECTING)
  createdAt     DateTime        @default(now())
  closedAt      DateTime?
  closingNote   String?
  shares        ProjectShare[]
  payments      ProjectPayment[]
  expenses      ProjectExpense[]
}

// Each flat's calculated share of a project, frozen at creation time from
// that flat's areaSqFt ÷ total society sqft × targetAmount — so it doesn't
// shift under people mid-collection even if flats/areas change later.
model ProjectShare {
  id         String         @id @default(cuid())
  projectId  String
  project    SpecialProject @relation(fields: [projectId], references: [id])
  flatId     String
  flat       Flat           @relation(fields: [flatId], references: [id])
  areaSqFt   Float
  dueAmount  Float

  @@unique([projectId, flatId])
}

// Money a resident actually pays in toward a project's collection.
model ProjectPayment {
  id         String         @id @default(cuid())
  projectId  String
  project    SpecialProject @relation(fields: [projectId], references: [id])
  flatId     String
  flat       Flat           @relation(fields: [flatId], references: [id])
  amount     Float
  date       DateTime
  mode       PaymentMode    @default(CASH)
  note       String?
  receiptNo  String?        @unique
  createdAt  DateTime       @default(now())
}

// Money spent out of the project's own fund (painter, contractor, etc.)
// This never touches the main cashbook — it's the project's own ledger.
model ProjectExpense {
  id          String         @id @default(cuid())
  projectId   String
  project     SpecialProject @relation(fields: [projectId], references: [id])
  amount      Float
  date        DateTime
  description String
  billUpload  String?
  createdAt   DateTime       @default(now())
}